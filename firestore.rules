rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasPublicProfile(userId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(userId)).data.settings.publicProfile == true;
    }

    function isConversationParticipant(conversation) {
      return request.auth != null && request.auth.uid in conversation.participants;
    }

    // Los perfiles se consultan desde users; las actividades siguen siendo privadas.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if ownsUser(userId);

      match /activities/{activityId} {
        allow read: if ownsUser(userId) || hasPublicProfile(userId);
        allow create, update, delete: if ownsUser(userId);
      }
    }

    // Las conversaciones son privadas aun si el perfil del participante es público.
    match /conversations/{conversationId} {
      allow read: if isConversationParticipant(resource.data);
      allow create: if request.auth != null
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if isConversationParticipant(resource.data)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        );
        allow create: if isConversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.read == false;
        allow update: if isConversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        )
          && resource.data.senderId != request.auth.uid
          && resource.data.read == false
          && request.resource.data.read == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
        allow delete: if false;
      }
    }
  }
}
